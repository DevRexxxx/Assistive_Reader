{
  "manifest_version": 3,
  "name": "AssistiveReader",
  "version": "5.0.0",
  "description": "Privacy-first customizable reading support for neurodivergent users. Zero AI, zero telemetry.",
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "permissions": [
    "activeTab",
    "sidePanel",
    "storage",
    "scripting",
    "alarms",
    "notifications"
  ],
  "side_panel": {
    "default_path": "src/sidepanel/index.html"
  },
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/index.ts"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["assets/*", "*.wasm", "*.onnx"],
      "matches": ["<all_urls>"]
    }
  ]
}
